APP_NAME=API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

LLM_PROVIDER=openai
LLM_MODEL=gpt-5.2
OPENAI_API_KEY=

# Required when TEST_MODE=false
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_ALGORITHMS=RS256

# TEST_MODE=true disables auth requirement for /api/chat when Authorization is absent
TEST_MODE=true
TEST_USER_ID=user-test
TEST_USER_EMAIL=test-user@example.com

MAX_PLOT_DATA_POINTS=300
MAX_PLOT_PAYLOAD_BYTES=200000
